{
    "name": "ohdearapp/nova-ohdear-tool",
    "description": "Display Oh Dear monitoring checks in Laravel Nova.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "homepage": "https://github.com/ohdearapp/nova-ohdear-tool",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "homepage": "https://ohdear.app",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "laravel/nova": "^5.11.1",
        "ohdearapp/ohdear-php-sdk": "^4.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "OhDear\\OhDearTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OhDear\\OhDearTool\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OhDear\\OhDearTool\\OhDearToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:test": "pint --test"
    }
}
